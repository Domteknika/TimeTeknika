# À recopier dans .env pour Docker. Générer SETUP_TOKEN :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
# ADRESSE D'ACCES A L'APPLICATION (sans chemin ni slash final)
# Remplacer par le domaine configure dans Cloudflare Tunnel.
APP_URL=https://temps.votre-domaine.ch
# Les cookies securises sont actives automatiquement pour HTTPS.
# Pour un essai local uniquement : APP_URL=http://localhost:4310
# Le tunnel/reverse proxy se configure separement ; voir docs/INSTALLATION_LINUX.md.

# PostgreSQL : renseigner une URL postgresql:// avec le compte applicatif.
# Appliquer d'abord pnpm db:migrate, puis pnpm start.
# Vide : conserve le stockage SQLite existant. Aucun import automatique.
DATABASE_URL=
# Base de demonstration SEPAREE ; pnpm demo ignore DATABASE_URL.
# Appliquer pnpm db:migrate --demo avant de l'utiliser.
DEMO_DATABASE_URL=
