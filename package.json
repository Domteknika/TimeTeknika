{
  "name": "timeteknika",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Suivi du temps collaboratif, hébergé localement",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node --env-file-if-exists=.env server/index.mjs --demo",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:real": "node --env-file-if-exists=.env scripts/dev.mjs --real",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.db.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-sqlite.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-journal.mjs --postgres",
    "test:db": "node --test tests/postgres-*.test.mjs",
    "test:ui": "pnpm build && playwright test",
    "release": "pnpm check:public && pnpm build && node scripts/package-release.mjs",
    "check:public": "node scripts/check-public-repo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "1.73.0",
    "next-themes": "^0.4.6",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "linkedom": "0.18.12",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
